//
//  Secrets.xcconfig.template
//  사용법: 이 파일을 같은 폴더에 Secrets.xcconfig 로 복사한 뒤 실제 값 기입.
//  키 발급: developers.kakao.com > 내 애플리케이션 > 앱 키 > "네이티브 앱 키"
//  Secrets.xcconfig 는 gitignore 됨 — 절대 커밋 금지 (CLAUDE.md '하지 말 것')
//
KAKAO_NATIVE_APP_KEY = paste_your_native_app_key_here

//  서버 주소. 팀 공유 채널에서 받아 기입.
//  xcconfig 는 `//` 가 주석이라 `http://` 를 그대로 못 쓴다 — `$()` 로 끊을 것.
//  예) BASE_URL = http:/$()/1.2.3.4:8080
BASE_URL = paste_your_base_url_here
